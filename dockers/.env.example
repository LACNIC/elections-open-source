# Configuracion Docker. Copiar como dockers/.env y reemplazar las credenciales.
# Incluye las variables del entorno autocontenido y del Compose tradicional.
# Estos valores son solo para desarrollo y no deben reutilizarse en produccion.

VERSION=dev
FRESH_BASE_IMAGE=quay.io/wildfly/wildfly:34.0.0.Final-jdk17
FRESH_MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-17
JAVA_OPTS=-Xms512m -Xmx1024m
TZ=America/Montevideo

# Entorno autocontenido (docker-compose.fresh.yml).
APP_HOST_PORT=8098
POSTGRES_HOST_PORT=54329
MAILPIT_WEB_PORT=8025

POSTGRES_SUPERUSER_PASSWORD=postgres-fresh
ELECTIONS_DB_NAME=elections
ELECTIONS_DB_USER=elections
ELECTIONS_DB_PASSWORD=elections-fresh
DB_ELECTIONS_MIN_POOL_SIZE=1
DB_ELECTIONS_MAX_POOL_SIZE=10

# Autenticacion de servicios WS. Se consume desde el entorno, no desde la tabla parameter.
WS_AUTH_METHOD=APP
WS_AUTH_TOKEN=fresh-local-token
WS_AUTHORIZED_IPS=127.0.0.1/32
WS_LACNIC_AUTH_URL=https://auth.example.org/portal-ws/authorization

FRESH_ORGANIZATION_NAME=Organizacion de prueba
FRESH_PUBLIC_BASE_URL=http://localhost:8098/
# Habilita el formulario publico de nominacion para cualquier tipo de eleccion.
FRESH_PUBLIC_NOMINATION_ENABLED=false
# Credenciales del primer login en /elections/login. Cambiarlas antes de `up`.
FRESH_ADMIN_USER=admin
FRESH_ADMIN_PASSWORD=change-me
FRESH_ADMIN_EMAIL=admin@example.test
FRESH_DEFAULT_SENDER=elecciones@example.test

# SMTP usado por la aplicacion. Estos valores apuntan al Mailpit incluido.
FRESH_EMAIL_HOST=mailpit
FRESH_EMAIL_USER=fresh
FRESH_EMAIL_PASSWORD=fresh

# Compose tradicional (docker-compose.yml).
# El contenedor genera elections.properties con estas variables al iniciar.
# Son la fuente de verdad para la autenticacion WS y el login administrativo.
# PAI pueden quedar inhabilitados cuando la organizacion usa APP.
URL_PORTAL_WS=https://example.invalid/pai
PORTAL_APIKEY=replace-me

DB_ELECTIONS_HOST=localhost
DB_ELECTIONS_PORT=5432
DB_ELECTIONS_NAME=elections
DB_ELECTIONS_USER=elections
DB_ELECTIONS_PASSWORD=replace-me
